// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Sales & Marketing Platform enums (Phase 1 foundation)
//
// These enums power the platform-level (non-tenant) Sales Platform. They live
// alongside the operational Study Hall domain but are NOT scoped by
// `studyhallId`. They describe the business side of Studivo: marketing,
// lead collection, the internal CRM, and the future sales pipeline.
// ===========================================================================

// Platform-level roles that exist OUTSIDE any StudyHall tenant. A user with a
// `platformRole` operates the Studivo platform itself (sales, support, ops)
// and is intentionally distinct from the tenant `role` string
// (admin/staff/member) used inside a venue. See ADR-011.
enum PlatformRole {
  SUPER_ADMIN
  SALES
  SUPPORT
}

// The sales pipeline stages a Lead moves through. Modeled now so the pipeline
// can be implemented later without a destructive migration. See ADR-013.
enum LeadStage {
  NEW
  CONTACTED
  DEMO
  TRIAL
  CUSTOMER
  LOST
}

// Acquisition channel category for a Lead/Campaign. Kept as an enum (not a
// table) because channels are a small, stable, query-hot set. Specific
// campaigns live in the `Campaign` table. See ADR-014.
enum LeadSource {
  DIRECT
  ORGANIC_SEARCH
  PAID_SEARCH
  SOCIAL
  REFERRAL
  MARKETING_SITE
  OTHER
}

// The kind of touchpoint recorded on a Lead/Company timeline.
enum InteractionType {
  NOTE
  CALL
  EMAIL
  SMS
  MEETING
  DEMO
}

// Lifecycle of a demo request from creation to outcome.
enum DemoRequestStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

// Business lifecycle of a Company (CRM account). A "Customer" is not a
// separate table: it is a Company in ACTIVE status with one or more linked
// StudyHalls. See ADR-012.
enum CompanyStatus {
  PROSPECT
  TRIAL
  ACTIVE
  CHURNED
}

// Lifecycle of a referral submitted by an existing customer/company.
enum ReferralStatus {
  PENDING
  QUALIFIED
  CONVERTED
  REJECTED
}

model StudyHall {
  id                      String   @id @default(cuid())
  name                    String   @default("سالن مطالعه")
  totalSeats              Int      @default(0)
  monthlyFee              Float    @default(0)
  gender                  String   @default("unspecified")
  address                 String   @default("")
  reminderDaysBefore      Int      @default(3)
  renewalRemindersEnabled Boolean  @default(true)
  expiryRemindersEnabled  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users             User[]
  seats             Seat[]
  subscriptions     Subscription[]
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]
  renewalReminders  RenewalReminder[]

  // Optional link from the operational tenant to the CRM Company that owns it.
  // Nullable + onDelete: SetNull so that:
  //  - existing study halls keep working with no company (backwards compatible);
  //  - deleting a CRM Company NEVER cascades into operational venue data.
  // This is the single bridge between the sales world and the tenant world.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("studyhall")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  phoneNumber       String?
  role              String             @default("member")
  subscriptions     Subscription[]
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]

  // Platform-level role, separate from the tenant `role` string above.
  // NULL for ordinary venue users (admin/staff/member). A SUPER_ADMIN / SALES
  // / SUPPORT user has a platformRole and typically NO studyhallId, because
  // they operate the Studivo platform itself rather than a single venue.
  // See ADR-011.
  platformRole PlatformRole?

  // Sales Platform ownership relations (platform users only).
  ownedLeads         Lead[]        @relation("LeadOwner")
  loggedInteractions Interaction[] @relation("InteractionAuthor")

  studyhallId String?
  studyhall   StudyHall? @relation(fields: [studyhallId], references: [id], onDelete: Cascade)

  @@unique([email])
  @@unique([studyhallId, phoneNumber])
  @@index([studyhallId])
  @@index([platformRole])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Seat {
  id            String         @id @default(cuid())
  seatNumber    Int
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]

  studyhallId String
  studyhall   StudyHall @relation(fields: [studyhallId], references: [id], onDelete: Cascade)

  @@unique([studyhallId, seatNumber])
  @@map("seat")
}

model Subscription {
  id            String   @id @default(cuid())
  userId        String
  seatId        String
  startDate     DateTime @default(now())
  endDate       DateTime
  paymentStatus String   @default("unpaid") // paid, unpaid
  status        String   @default("active") // active, expired, cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat Seat @relation(fields: [seatId], references: [id], onDelete: Cascade)

  studyhallId      String
  studyhall        StudyHall         @relation(fields: [studyhallId], references: [id], onDelete: Cascade)
  renewalReminders RenewalReminder[]

  @@index([userId])
  @@index([seatId])
  @@index([studyhallId])
  @@map("subscription")
}

model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  studyhallId String
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyhall StudyHall @relation(fields: [studyhallId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([studyhallId])
  @@map("pushsubscription")
}

model RenewalReminder {
  id             String   @id @default(cuid())
  subscriptionId String
  studyhallId    String
  reminderKey    String
  sentAt         DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  studyhall    StudyHall    @relation(fields: [studyhallId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, reminderKey])
  @@index([studyhallId])
  @@map("renewalreminder")
}

model AuditLog {
  id          String   @id @default(cuid())
  studyhallId String
  userId      String
  action      String
  details     Json
  createdAt   DateTime @default(now())

  studyhall StudyHall @relation(fields: [studyhallId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studyhallId, createdAt])
  @@index([userId])
  @@map("auditlog")
}

model OtpVerification {
  id          String   @id @default(cuid())
  phoneNumber String
  code        String
  purpose     String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([phoneNumber, purpose])
  @@map("otpverification")
}

// ===========================================================================
// Sales & Marketing Platform models (Phase 1 foundation)
//
// These models are PLATFORM-LEVEL. They are intentionally NOT scoped by
// `studyhallId` and are never read by tenant dashboard queries. They are
// owned and operated by platform users (SUPER_ADMIN / SALES / SUPPORT).
//
// Business entity chain:
//   Visitor → Lead → Company → StudyHall → Customer
//   (anonymous) (interested) (CRM account) (tenant) (active company)
//
// The bridge to the existing tenant world is the single nullable
// `StudyHall.companyId` relation. No operational model gains a sales column.
// ===========================================================================

// Company is the CRM account: the business/organization behind a prospect or
// customer. One Company can eventually operate MANY StudyHalls (branches),
// which is why it is modeled separately from the tenant StudyHall. A
// "Customer" is simply a Company with status ACTIVE and >= 1 linked StudyHall;
// there is deliberately no separate Customer table (avoids duplicate data).
model Company {
  id     String        @id @default(cuid())
  name   String
  status CompanyStatus @default(PROSPECT)

  // Primary point-of-contact snapshot for the account.
  contactName  String?
  contactPhone String?
  contactEmail String?
  city         String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads             Lead[]
  studyHalls        StudyHall[]
  interactions      Interaction[]
  demoRequests      DemoRequest[]
  referralsReferred Referral[]    @relation("ReferringCompany")

  @@index([status])
  @@map("company")
}

// Lead is the sales-world record of interest. It is created the moment an
// anonymous Visitor identifies themselves (a contact/demo form submission).
// A Lead is pre-sale and may never become a customer, which is exactly why it
// is separate from StudyHall (a post-sale operational tenant). See ADR-013.
model Lead {
  id        String  @id @default(cuid())
  name      String?
  phone     String?
  email     String?
  venueName String? // prospective study hall name the lead mentioned
  city      String?
  message   String?

  stage      LeadStage  @default(NEW)
  source     LeadSource @default(MARKETING_SITE)
  lostReason String?

  // Attribution + ownership (all nullable; a raw inbound lead has none).
  campaignId String?
  companyId  String? // set when the lead is qualified into a CRM account
  ownerId    String? // platform user (SALES/SUPER_ADMIN) responsible

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  convertedAt DateTime? // timestamp the lead reached CUSTOMER stage

  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner        User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  interactions Interaction[]
  demoRequests DemoRequest[]
  referral     Referral?

  @@index([stage])
  @@index([source])
  @@index([companyId])
  @@index([campaignId])
  @@index([ownerId])
  @@index([createdAt])
  @@map("lead")
}

// DemoRequest is a discrete, schedulable request for a product demo. Kept
// separate from Lead because a single lead can request several demos over
// time, and a demo carries its own scheduling/outcome lifecycle.
model DemoRequest {
  id          String            @id @default(cuid())
  leadId      String?
  companyId   String?
  scheduledAt DateTime?
  status      DemoRequestStatus @default(REQUESTED)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([companyId])
  @@index([status])
  @@index([scheduledAt])
  @@map("demorequest")
}

// Interaction is a single entry on a Lead/Company activity timeline (a call,
// email, SMS, meeting, or free-form note). This is the CRM's audit trail for
// the sales relationship, analogous to AuditLog for venue operations.
model Interaction {
  id         String          @id @default(cuid())
  type       InteractionType @default(NOTE)
  body       String
  leadId     String?
  companyId  String?
  authorId   String? // platform user who logged the interaction
  occurredAt DateTime        @default(now())
  createdAt  DateTime        @default(now())

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User?    @relation("InteractionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([companyId])
  @@index([authorId])
  @@index([occurredAt])
  @@map("interaction")
}

// Campaign is a specific, named marketing initiative leads can be attributed
// to (e.g. an Instagram launch push). The reusable channel category lives on
// `LeadSource`; Campaign holds the dynamic, per-initiative UTM metadata.
model Campaign {
  id          String     @id @default(cuid())
  name        String
  source      LeadSource @default(MARKETING_SITE)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@index([isActive])
  @@map("campaign")
}

// Referral tracks word-of-mouth growth: an existing company/customer (or a
// named referrer) introduces a new lead. Modeled now so a future referral/
// reward program has a home without a schema rewrite.
model Referral {
  id                String         @id @default(cuid())
  referrerName      String?
  referrerCompanyId String?
  referredLeadId    String?        @unique
  status            ReferralStatus @default(PENDING)
  rewardNote        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrerCompany Company? @relation("ReferringCompany", fields: [referrerCompanyId], references: [id], onDelete: SetNull)
  referredLead    Lead?    @relation(fields: [referredLeadId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([referrerCompanyId])
  @@map("referral")
}
