generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  SUPER_ADMIN
  SALES
}
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  phoneNumber String? @map("phone_number")

  memberships Membership[]

  staffAssignments StaffAssignment[]

  notifications Notification[]

  auditLogs AuditLog[] @relation("UserAuditLogs")

  createdPayments Payment[] @relation("PaymentCreatedBy")
  voidedPayments  Payment[] @relation("PaymentVoidedBy")

  createdExpenses Expense[] @relation("ExpenseCreatedBy")
  voidedExpenses  Expense[] @relation("ExpenseVoidedBy")

  checkedInAttendances Attendance[] @relation("AttendanceCheckedInBy")

  checkedOutAttendances Attendance[] @relation("AttendanceCheckedOutBy")

  platformRole PlatformRole? @map("platform_role")

  ownedLeads Lead[] @relation("LeadOwner")

  pushSubscriptions PushSubscription[]
  demoRequests      DemoRequest[]

  @@unique([email])
  @@unique([phoneNumber])
  @@index([platformRole])
  @@map("user")
}
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}


enum LeadSource {
  WEBSITE
  INSTAGRAM
  TELEGRAM
  REFERRAL
  PHONE
  MANUAL
  OTHER
}
enum LeadStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  DEMO_COMPLETED
  NEGOTIATION
  CONVERTED
  LOST
}
model Lead {
  id            String     @id @default(cuid())
  fullName      String
  studyhallName String?    @map("studyhall_name")
  phoneNumber   String?    @map("phone_number")
  email         String?
  city          String?
  source        LeadSource
  status        LeadStatus @default(NEW)
  ownerId       String?    @map("owner_id")
  owner         User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  convertedStudyHallId String?    @map("converted_studyhall_id")
  convertedStudyHall   StudyHall? @relation(fields: [convertedStudyHallId], references: [id], onDelete: SetNull)

  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  demoRequests DemoRequest[]

  @@index([ownerId])
  @@index([status])
  @@map("lead")
}
enum DemoRequestStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
}
model DemoRequest {
  id          String            @id @default(cuid())
  leadId      String            @map("lead_id")
  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt DateTime?         @map("scheduled_at")
  status      DemoRequestStatus @default(PENDING)
  note        String?
  createdById String?           @map("created_by_id")
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([status])
  @@map("demo_requests")
}


enum Gender {
  MALE
  FEMALE
}
model StudyHall {
  id          String   @id @default(cuid())
  name        String
  slug        String?
  gender      Gender
  phoneNumber String?  @map("phone_number")
  address     String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  publicPageEnabled Boolean  @default(false)
  heroImage         String? // Vercel Blob public URL
  galleryImages     String[] @default([])

  membershipPlans  MembershipPlan[]
  memberships      Membership[]
  sections         Section[]
  seats            Seat[]
  staffAssignments StaffAssignment[]
  expenses         Expense[]
  auditLogs        AuditLog[]
  leads            Lead[]

  @@unique([slug])
  @@index([isActive])
  @@map("studyhall")
}
model Section {
  id          String    @id @default(cuid())
  studyHallId String    @map("studyhall_id")
  studyHall   StudyHall @relation(fields: [studyHallId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  seats Seat[]

  @@unique([studyHallId, name])
  @@index([studyHallId])
  @@map("sections")
}
model Seat {
  id          String    @id @default(cuid())
  studyHallId String    @map("studyhall_id")
  studyHall   StudyHall @relation(fields: [studyHallId], references: [id], onDelete: Cascade)
  sectionId   String?   @map("section_id")
  section     Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  number      String
  isActive    Boolean   @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignments SeatAssignment[]

  @@unique([studyHallId, number])
  @@index([studyHallId])
  @@index([sectionId])
  @@map("seats")
}


enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}
model Membership {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyHallId      String           @map("studyhall_id")
  studyHall        StudyHall        @relation(fields: [studyHallId], references: [id], onDelete: Cascade)
  membershipPlanId String           @map("membership_plan_id")
  membershipPlan   MembershipPlan   @relation(fields: [membershipPlanId], references: [id])
  status           MembershipStatus
  startsAt         DateTime         @map("starts_at")
  endsAt           DateTime         @map("ends_at")
  planName         String           @map("plan_name")
  planDurationDays Int              @map("plan_duration_days")
  planPrice        Decimal          @map("plan_price") @db.Decimal(10, 2)
  hasFixedSeat     Boolean          @map("has_fixed_seat")
  note             String?
  updatedAt        DateTime         @updatedAt @map("updated_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  payments        Payment[]
  seatAssignments SeatAssignment[]
  attendances     Attendance[]

  @@index([userId])
  @@index([studyHallId])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@map("memberships")
}
model MembershipPlan {
  id String @id @default(cuid())

  studyHallId String    @map("studyhall_id")
  studyHall   StudyHall @relation(fields: [studyHallId], references: [id], onDelete: Cascade)

  name String

  durationDays Int @map("duration_days")

  price Decimal @db.Decimal(10, 2)

  hasFixedSeat Boolean @default(true) @map("has_fixed_seat")

  isActive Boolean @default(true) @map("is_active")

  description String?

  memberships Membership[]

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([studyHallId])
  @@index([isActive])
  @@map("membership_plans")
}


model Attendance {
  id             String     @id @default(cuid())
  membershipId   String     @map("membership_id")
  membership     Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  checkedInAt    DateTime   @map("checked_in_at")
  checkedOutAt   DateTime?  @map("checked_out_at")
  checkedInById  String?    @map("checked_in_by_id")
  checkedInBy    User?      @relation("AttendanceCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  checkedOutById String?    @map("checked_out_by_id")
  checkedOutBy   User?      @relation("AttendanceCheckedOutBy", fields: [checkedOutById], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([membershipId])
  @@index([checkedInAt])
  @@index([checkedOutAt])
  @@map("attendance")
}
model SeatAssignment {
  id           String     @id @default(cuid())
  membershipId String     @map("membership_id")
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  seatId       String     @map("seat_id")
  seat         Seat       @relation(fields: [seatId], references: [id], onDelete: Cascade)
  startsAt     DateTime   @map("starts_at")
  endsAt       DateTime?  @map("ends_at")
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([membershipId])
  @@index([seatId])
  @@index([startsAt])
  @@index([endsAt])
  @@map("seat_assignments")
}


enum PaymentMethod {
  CASH
  POS
  CARD_TO_CARD
  ONLINE
}
enum PaymentStatus {
  PENDING
  COMPLETED
  VOIDED
}
model Payment {
  id           String        @id @default(cuid())
  membershipId String        @map("membership_id")
  membership   Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  status       PaymentStatus
  paidAt       DateTime?     @map("paid_at")
  note         String?
  createdById  String        @map("created_by_id")
  createdBy    User          @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  voidedAt     DateTime?     @map("voided_at")
  voidReason   String?       @map("void_reason")
  voidedById   String?       @map("voided_by_id")
  voidedBy     User?         @relation("PaymentVoidedBy", fields: [voidedById], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([membershipId])
  @@index([status])
  @@index([paidAt])
  @@index([createdById])
  @@map("payment")
}
enum ExpenseCategory {
  RENT
  ELECTRICITY
  WATER
  INTERNET
  CLEANING
  EQUIPMENT
  SALARY
  OTHER
}
model Expense {
  id          String          @id @default(cuid())
  studyHallId String          @map("studyhall_id")
  studyHall   StudyHall       @relation(fields: [studyHallId], references: [id], onDelete: Cascade)
  title       String
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory
  occurredAt  DateTime        @map("occurred_at")
  note        String?
  createdById String          @map("created_by_id")
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  voidedAt    DateTime?       @map("voided_at")
  voidReason  String?         @map("void_reason")
  voidedById  String?         @map("voided_by_id")
  voidedBy    User?           @relation("ExpenseVoidedBy", fields: [voidedById], references: [id])
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([studyHallId])
  @@index([occurredAt])
  @@index([createdById])
  @@map("expenses")
}


model Shift {
  id                String          @id @default(cuid())
  staffAssignmentId String          @map("staff_assignment_id")
  staffAssignment   StaffAssignment @relation(fields: [staffAssignmentId], references: [id], onDelete: Cascade)
  startsAt          DateTime        @map("starts_at")
  endsAt            DateTime        @map("ends_at")
  note              String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([staffAssignmentId])
  @@index([startsAt])
  @@index([endsAt])
  @@map("shifts")
}
enum HallRole {
  OWNER
  STAFF
}
model StaffAssignment {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyHallId String    @map("studyhall_id")
  studyHall   StudyHall @relation(fields: [studyHallId], references: [id], onDelete: Cascade)
  role        HallRole
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  shifts Shift[]

  @@index([userId])
  @@index([studyHallId])
  @@index([role])
  @@index([isActive])
  @@map("staff_assignments")
}


enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VOID
  CHECK_IN
  CHECK_OUT
}
enum AuditEntity {
  STUDYHALL
  USER
  MEMBERSHIP_PLAN
  MEMBERSHIP
  PAYMENT
  SEAT
  SEAT_ASSIGNMENT
  ATTENDANCE
  STAFF_ASSIGNMENT
  SHIFT
  EXPENSE
  NOTIFICATION
}
model AuditLog {
  id          String      @id @default(cuid())
  studyHallId String?     @map("studyhall_id")
  studyHall   StudyHall?  @relation(fields: [studyHallId], references: [id], onDelete: Cascade)
  actorId     String?     @map("actor_id")
  actor       User?       @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action      AuditAction
  entityType  AuditEntity @map("entity_type")
  entityId    String      @map("entity_id")
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([studyHallId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
enum NotificationType {
  MEMBERSHIP_EXPIRING
  PAYMENT_DUE
  PAYMENT_RECEIVED
  SYSTEM
}
model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}


enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
}
model OtpVerification {
  id          String     @id @default(cuid())
  phoneNumber String     @map("phone_number")
  code        String
  purpose     OtpPurpose @default(LOGIN)
  expiresAt   DateTime   @map("expires_at")
  usedAt      DateTime?  @map("used_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([phoneNumber])
  @@index([expiresAt])
  @@map("otp_verifications")
}
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_subscriptions")
}
